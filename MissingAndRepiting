public class MissingAndRepiting {
    public static void main(String[] args) {
        int[] arr = {3,1,3};
        missing(arr);
    }

    static void missing(int[] arr) {
        int count = 0,missing=-1,duplicate=-1;
        for (int i = 1; i <= arr.length; i++) {
            count = 0;
            for (int j = 0; j < arr.length; j++) {
                if (arr[j] == i) {
                    count++;
                }
            }
            if (count == 2) {
                duplicate=i;
            }
            if(count==0){
                missing=i;
            }
        }
        System.out.println("["+duplicate+" "+ missing+"]");

    }
}
